# Copy to .env. Nothing here is needed to run the simulated stack.

# Real LLM providers (any OpenAI-compatible endpoint). Keys are read from these variables,
# named in config/settings.yaml (llm.providers[].api_key_env).
PRIMARY_LLM_API_KEY=
SECONDARY_LLM_API_KEY=
# DCR_SETTINGS_OVERRIDE='{llm: {providers: [{name: primary, base_url: "https://api.openai.com/v1", model: gpt-4o-mini, api_key_env: PRIMARY_LLM_API_KEY}, {name: secondary, base_url: "http://vllm:8000/v1", model: Qwen/Qwen2.5-7B-Instruct, api_key_env: SECONDARY_LLM_API_KEY}]}}'

# Public https/wss URL Twilio reaches the runtime on (used in the TwiML <Stream url>)
# DCR_PUBLIC_URL=https://voice.example

# Where calls are stored
# DCR_DB=/app/data/calls.sqlite
